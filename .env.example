# ============================================================================
# HERBTRACE — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to backend/.env, contracts/.env, and frontend/.env
# NEVER commit real private keys, production database credentials, or secrets.
# ============================================================================

# --- Server & Environment ---
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173

# --- Database (MongoDB) ---
MONGODB_URI=mongodb://127.0.0.1:27017/herbtrace_db

# --- Authentication & Security ---
JWT_SECRET=replace_with_64_byte_cryptographic_random_secret_in_production
JWT_EXPIRES_IN=24h
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=150

# --- Polygon-Compatible EVM Blockchain (Amoy Testnet / Local Hardhat) ---
CHAIN_ID=80002
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
LOCAL_RPC_URL=http://127.0.0.1:8545
RELAYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
HERBTRACE_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# --- Off-Chain Document / IPFS Storage ---
IPFS_GATEWAY_URL=https://ipfs.io/ipfs/
MAX_UPLOAD_SIZE_BYTES=5242880
